@article{liu2026dmsnet,
  title = {DMSNet: Cross-Band Learning for Multi-Target Sensing in Dual-Band ISAC},
  author = {Haotian Liu and Zhiqing Wei* and Quanjiang Zhao and Lin Wang and Yunxin Geng and Xingwang Li and Zhiyong Feng*},
  journal = {IEEE Wireless Communications Letters},
  year = {2026},
  citations = {0},
  cas_zone = {3},
  cas_top = {false},
  cas_year = {2025},
  jcr_quartile = {Q1},
  jcr_year = {2025},
  impact_factor = {5.5},
  impact_factor_year = {2025},
  month = sep,
  url = {https://ieeexplore.ieee.org/document/11685992},
  doi = {10.1109/LWC.2026.3732429},
  keywords = {Integrated Sensing and Communication, Multi-Band Sensing, Multi-Target Sensing, High- and Low-Frequency Cooperation, Deep Learning},
  abstract = {Dual-band integrated sensing and communication (ISAC) offers complementary high- and low-frequency echo information for multi-target sensing. However, existing dual-band ISAC sensing methods have a limited ability to exploit deep complementary information across heterogeneous bands and often incur high computational costs. To address these limitations, we propose a Dual-Band Multi-Target Sensing Neural Network (DMSNet) for joint target number and parameter estimation. Under representative simulation conditions, DMSNet outperforms the best baseline in target number estimation, increasing count accuracy from 89.01% to 91.74% and Macro-F1 from 90.80% to 93.07%. For parameter estimation, compared with the best baselines, DMSNet reduces the median absolute errors of range, velocity, and angle by 82.2%, 56.9%, and 73.2%, respectively. Moreover, DMSNet reduces runtime by 68.7% relative to the fastest existing dual-band ISAC sensing method.},
  preview = {liu2026dmsnet.jpg}
}

@article{liu2026wctnet,
  selected = {true},
  selected_order = {2},
  title = {WCTNet-ISAC: A Two-Stage Scheme with CSI Enhancement and High-Precision Synchronization for Uplink ISAC Signal Processing},
  author = {Haotian Liu and Zhiqing Wei* and Yucong Du and Bohao Lu and Furong Yang and Xingwang Li and Zhiyong Feng*},
  journal = {IEEE Transactions on Mobile Computing},
  year = {2026},
  citations = {0},
  cas_zone = {1},
  cas_top = {true},
  cas_year = {2025},
  jcr_quartile = {Q1},
  jcr_year = {2025},
  impact_factor = {9.2},
  impact_factor_year = {2025},
  month = may,
  url = {https://ieeexplore.ieee.org/document/11535612},
  doi = {10.1109/TMC.2026.3697394},
  keywords = {Integrated Sensing and Communication, Signal Processing},
  abstract = {Uplink (UL) integrated sensing and communication (ISAC) has attracted significant attention for sixth-generation mobile networks due to its low hardware modification costs and compatibility with standard communication signals. However, UL ISAC signal processing faces two main challenges: 1) Effectively mitigating the impact of time offset (TO) and carrier frequency offset (CFO) on both communication and sensing remains a key challenge. 2) High-precision separation and parameter estimation for congested UL echoes are challenging. To address these challenges, this paper proposes a novel two-stage signal processing scheme for UL ISAC, termed “WCTNet-ISAC”, to achieve reliable communication and high-precision sensing. The first stage designs a new neural network, the wireless channel transformer network (WCTNet), for the estimation of TO and CFO as well as for channel information matrix enhancement, thereby mitigating the impact of synchronization errors on UL ISAC. In the second stage, we propose an iterative grid matching sensing (IGMS) method for low-complexity and high-precision parameter estimation, thereby obtaining high-precision localization and velocity estimation of the scatterers. The simulation results demonstrate the superiority of the WCTNet-ISAC scheme over the existing UL ISAC signal processing schemes in terms of communication and sensing performance. Compared to the state-of-the-art grid search-based parameter estimation method, the IGMS method reduces runtime by 23.7% with the same estimation accuracy.},
  preview = {liu2026wctnet.jpg}
}

@article{liu2026cooperative,
  selected = {true},
  selected_order = {1},
  title = {Cooperative Sensing in Cell-Free Massive MIMO ISAC Systems: Performance Optimization and Signal Processing},
  author = {Haotian Liu and Zhiqing Wei* and Luyang Sun and Ruizhong Xu and Yixin Zhang and Zhiyong Feng*},
  journal = {IEEE Transactions on Wireless Communications},
  year = {2026},
  citations = {16},
