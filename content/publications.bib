  impact_factor_year = {2025},
  month = may,
  url = {https://ieeexplore.ieee.org/document/10982441},
  doi = {10.1109/TAP.2025.3564785},
  note = {Popular Paper},
  keywords = {Stretchable Antennas, Surface Current},
  abstract = {Stretchable and flexible antennas are pivotal in wearable electronics and soft robotics, but achieving consistent resonant frequency under mechanical strain is a fundamental problem that remains to be solved. This article introduces, for the first time, a strain-invariant patch antenna fabricated with a liquid-metal conductor, EGaIn, and a soft elastomeric substrate, Ecoflex 00-30, with overall dimensions of 90 × 90 × 1.5 mm3 . By strategically employing slot-induced surface current redistribution and leveraging Poisson’s effect, the proposed design achieves an exceptional level of frequency stability. Experimental results demonstrate a maximum frequency shift of only 0.8% under strains up to 58.8%, significantly outperforming existing straininvariant stretchable antennas, which typically exhibit significant frequency shifts for strains higher than 30%. Unlike conventional approaches that rely on specialized materials or complex 3-D structures, our planar antenna offers remarkable scalability and versatility, presenting a transformative solution for nextgeneration wireless communication and sensing systems for soft electronics.},
  preview = {yang2025strain.jpg}
}

@article{wei2026rotor,
  title = {Rotor Micro-Doppler Extraction in Protocol-Driven TDD ISAC With Periodic Sparse Sampling},
  author = {Jiachen Wei and Dingyou Ma and Kan Yu and Qixun Zhang and Haotian Liu and Zheng Jiang and Zhiyong Feng},
  journal = {IEEE Wireless Communications Letters},
  year = {2026},
  citations = {0},
  cas_zone = {3},
  cas_top = {false},
  cas_year = {2025},
  jcr_quartile = {Q1},
  jcr_year = {2025},
  impact_factor = {5.5},
  impact_factor_year = {2025},
  month = jun,
  url = {https://ieeexplore.ieee.org/document/11568786},
  doi = {10.1109/LWC.2026.3703825},
  keywords = {Integrated Sensing and Communication, Micro-Doppler, Sparse Sampling},
  abstract = {ISAC systems are promising for uncrewed aerial vehicle (UAV) detection, yet traditional body-Doppler methods miss the rich information in micro-Doppler signatures. Extracting such signatures is challenging because weak blade returns are easily overwhelmed by clutter. Moreover, protocol-driven time division duplexing (TDD) ISAC employs periodic sparse sensing to prioritize communication, which disrupts the fast-varying periodic structure of micro-Doppler signals. To address these problems, we propose the periodic sparse complex differential null space pursuit (PS-CDNSP) algorithm. By modeling rotor returns as amplitude- and frequency-modulated (AM-FM) components, we cast the extraction as a joint masked estimation problem. Specifically, we employ a complex differential operator to enforce null-space consistency on the rotor signal. Unlike existing dense-sampling operators that fail at unobserved boundaries, we introduce mask-aware reliability weighting to mitigate error propagation across sampling gaps. Simulations and hardware experiments show that PS-CDNSP achieves a correlation coefficient >0.9 at 0 dB signal-to-noise ratio (SNR) and extracts clear signatures using a single downlink slot per 2.5 ms period, outperforming existing baselines.},
  preview = {wei2026rotor.jpg}
}

@article{yang2026dualidentifier,
  title = {Physical-Digital Space Dual-Identifier-Driven Secure Communication for Intelligent Machines: Key Technologies and Hardware Platform},
  author = {Xiaohan Yang and Haotian Liu and Ying Zhou and Yanpeng Cui and Zhiqing Wei},
  journal = {Mobile Communications},
  year = {2026},
  citations = {0},
  month = may,
  keywords = {Secure Communication, Intelligent Machines},
  abstract = {With the development of intelligent manufacturing and the Industrial Internet, automated guided vehicle (AGV) networks improve production flexibility while facing severe security threats. Among these threats, Sybil attacks are particularly prominent because identities can be easily forged. Existing schemes mostly rely on purely digital authentication or a single physical feature, making it difficult to ensure accuracy and robustness in open industrial environments. To address this issue, a key technology framework for Sybil attack detection based on physical– digital space dual identifiers is proposed. Three core steps of dual-identifier-based Sybil attack detection are further detailed, including identifier formulation, identifier matching, and identifier management, along with the corresponding challenges and solutions. Validation on a semi-physical platform based on software-defined radio and multimodal sensors shows that the proposed mechanism can effectively support real-time generation and mapping of dual identifiers. It can also release resources after nodes move out of line of sight and rapidly reconstruct communication links after link failures, demonstrating its feasibility and practicality in industrial AGV scenarios.},
  preview = {yang2026dualidentifier.jpg}
}

@article{zhang2026passive,
  title = {Multi-Base Station Passive Cooperative Sensing Technology Based on Integrated Sensing and Communication},
  author = {Hongquan Zhang and Heng Yang and Hujun Li and Haotian Liu and Zhiqing Wei},
  journal = {ZTE Technology Journal},
  year = {2026},
  citations = {0},
  month = may,
  url = {https://www.zte.com.cn/content/dam/zte-site/res-www-zte-com-cn/mediares/magazine/publication/com_cn/article/202602/5.pdf},
  doi = {10.12142/ZTETJ.202602005},
  keywords = {Integrated Sensing and Communication, Cooperative Sensing, Passive Sensing},
  abstract = {To address the increasing demand for high-precision sensing and reliable communication in emerging applications such as lowaltitude economy and intelligent transportation, a multi-node passive cooperative sensing framework based on integrated sensing and com⁃ munication (ISAC) is investigated. In practical complex multi-base station sensing scenarios, challenges are posed by unstable line-of-sight (LoS) paths, asynchronous time offset (TO) and carrier frequency offset (CFO), as well as the difficulty of multi-base station passive data fu⁃ sion localization. To resolve these issues, an orthogonal frequency division multiplexing (OFDM) -based multi-point passive cooperative sensing signal processing scheme is established. First, the angle of arrival (AoA) and angle of departure (AoD) are estimated using a 2D mul⁃ tiple signal classification (MUSIC) algorithm, followed by angle compensation and dimensionality reduction. Then, a multi-point phase syn⁃ chronization cross-correlation (MPSCC) method adapted to unstable LoS conditions is proposed to suppress TO-induced ranging ambiguity. On this basis, a data-level fusion localization algorithm is developed, including an elliptic direction of arrival (DOA) joint positioning method when LoS exists and a time difference of arrival (TDOA) joint positioning method when LoS is absent, thereby enabling high-precision three-dimensional localization. Simulation results validate the feasibility of the proposed OFDM-based multi-point passive cooperative sensing signal processing scheme and demonstrate the effectiveness of the MPSCC method. Theoretical insights and algorithmic founda⁃ tions for cooperative sensing in future 6G ISAC networks are thus provided.},
  preview = {zhang2026passive.jpg}
}

@article{wei2026leo,
  title = {ISAC-Empowered LEO Constellation Networked Sensing: Challenges and Opportunities},
  author = {Zhiqing Wei* and Haotian Liu* and Yunxin Geng and Zhiyong Feng and Guan Gui and Kan Zheng},
  student_first = {true},
  journal = {IEEE Wireless Communications},
  year = {2026},
  citations = {3},
  cas_zone = {2},
  cas_top = {false},
  cas_year = {2025},
  jcr_quartile = {Q1},
  jcr_year = {2025},
  impact_factor = {11.5},
  impact_factor_year = {2025},
  month = feb,
  url = {https://ieeexplore.ieee.org/document/11417183},
  doi = {10.1109/MWC.2026.3654488},
  note = {Popular Paper},
  keywords = {Integrated Sensing and Communication, LEO, Networked Sensing},
  abstract = {The pursuit of seamless global coverage in sixthgeneration (6G) mobile networks has driven the development of low earth orbit (LEO) constellation networks. In addition to communication, the emerging 6G applications, such as low-altitude economy and smart city, also require high-accuracy, large-scale, and continuous sensing. Integrated sensing and communication (ISAC) has emerged as a key enabler, which could empower LEO constellations with dual capabilities of communication and sensing. With the implementation of networked sensing in ISAC-empowered LEO constellations, the requirements of emerging 6G applications can be satisfied. This article presents a comprehensive overview of networked sensing in ISAC-empowered LEO constellations. We first introduce the concepts, sensing types, application scenarios, and payload enhancements. Then, we delve into critical technical challenges of networked sensing in ISAC-empowered LEO constellations and discuss the promising solutions tailored to the unique characteristics of LEO constellations, such as high mobility and long distances to the targets. Finally, we highlight future research trends to further promote the performance of ISAC-empowered LEO constellations.},
  preview = {wei2026leo.jpg}
}

@article{wei2024deep,
  title = {Deep Cooperation in ISAC System: Resource, Node and Infrastructure Perspectives},
  author = {Zhiqing Wei* and Haotian Liu* and Zhiyong Feng and Huici Wu and Fan Liu and Qixun Zhang and Yucong Du},
  student_first = {true},
  journal = {IEEE Internet of Things Magazine},
  year = {2024},
  citations = {46},
  month = nov,
  url = {https://ieeexplore.ieee.org/document/10614082},
  doi = {10.1109/IOTM.001.2400042},
  note = {Popular Article since publication},
  keywords = {Integrated Sensing and Communication, Cooperation, Infrastructure},
  abstract = {With the emerging Integrated Sensing and Communication (ISAC) technique, exploiting the mobile communication system with multi-domain resources, multiple network elements, and largescale infrastructures to realize cooperative sensing is a crucial approach satisfying the requirements of high-accuracy and large-coverage sensing in Internet of Everything (IoE). In this article, the deep cooperation in ISAC system including three perspectives is investigated. In the microscopic perspective, namely, within a single node, the sensing information carried by time-frequencyspace-code multi-domain resources is processed, such as phase compensation, coherent accumulation and other operations, thereby improving the sensing accuracy. In the mesoscopic perspective, the sensing accuracy could be improved through the cooperation of multiple nodes. We explore various multi-node cooperative sensing scenarios and present the corresponding challenges and future research trends. In the macroscopic perspective, the massive number of infrastructures from the same operator or different operators could perform cooperative sensing to extend the sensing coverage and improve the sensing continuity. We investigate network architecture, target tracking methods, and the digital twin assisted large-coverage cooperative sensing. Simulation results demonstrate the superiority of multi-node and multi-resource cooperative sensing over non-cooperative sensing. This article may provide a deep and comprehensive view on the cooperative sensing in ISAC system to enhance the performance of sensing, supporting the applications of IoE.},
  preview = {wei2024deep.jpg}
}

@article{wei2026uav,
  title = {Integrated Sensing, Communication and Control Enabled Agile UAV Swarm},
  author = {Zhiqing Wei* and Yucong Du and Zhiyong Feng and Haotian Liu and Yanpeng Cui and Tao Zhang and Ying Zhou and Huici Wu},
  journal = {IEEE Internet of Things Magazine},
  year = {2026},
  citations = {2},
  month = jan,
  url = {https://ieeexplore.ieee.org/document/11366906},
  doi = {10.1109/MIOT.2025.3647932},
  note = {Popular Paper},
  keywords = {Integrated Sensing Communication and Control, UAV Swarm},
  abstract = {Unmanned aerial vehicle (UAV) swarms are pivotal in the applications such as disaster relief, aerial base station (BS) and logistics transportation. These scenarios require the capabilities in accurate sensing, efficient communication and flexible control for realtime and reliable task execution. However, sensing, communication and control are studied independently in traditional research, which limits the overall performance of UAV swarms. To overcome this disadvantage, we propose a deeply coupled scheme of integrated sensing, communication and control (ISCC) for UAV swarms, which is a systemic paradigm that transcends traditional isolated designs of sensing, communication and control by establishing a tightlycoupled closed-loop through the co-optimization of sensing, communication and control. In this article, we firstly analyze the requirements of scenarios and key performance metrics. Subsequently, the enabling technologies are proposed, including communication-and-control-enhanced sensing, sensingand-control-enhanced communication, and sensingand-communication-enhanced control. Simulation results validate the performance of the proposed ISCC framework, demonstrating its application potential in the future.},
  preview = {wei2026uav.jpg}
}

@inproceedings{liu2025localization,
  title = {Target Localization with Macro and Micro Base Stations Cooperative Sensing},
  author = {Haotian Liu and Zhiqing Wei* and Furong Yang and Huici Wu and Kaifeng Han and Zhiyong Feng},
  booktitle = {2024 IEEE Global Communications Conference (GLOBECOM)},
  year = {2025},
  citations = {13},
  month = mar,
  url = {https://ieeexplore.ieee.org/document/10900950},
  doi = {10.1109/GLOBECOM52923.2024.10900950},
  keywords = {Integrated Sensing and Communication, Cooperative Sensing, Target Localization},
  abstract = {Addressing the communication and sensing demands of sixth-generation (6G) mobile communication system, integrated sensing and communication (ISAC) has garnered traction in academia and industry. With the sensing limitation of single base station (BS), multi-BS cooperative sensing is regarded as a promising solution. The coexistence and overlapped coverage of macro BS (MBS) and micro BS (MiBS) are common in the development of 6G, making the cooperative sensing between MBS and MiBS feasible. Since MBS and MiBS work in low and high frequency bands, respectively, the challenges of MBS and MiBS cooperative sensing lie in the fusion method of the sensing information in high and low-frequency bands. To this end, this paper introduces a symbol-level fusion method and a grid-based three-dimensional discrete Fourier transform (3D- GDFT) algorithm to achieve precise localization of multiple targets with limited resources. Simulation results demonstrate that the proposed MBS and MiBS cooperative sensing scheme outperforms traditional single BS (MBS/MiBS) sensing scheme, showcasing superior sensing performance.},
  preview = {liu2025localization.jpg}
}

@inproceedings{liu2025component,
  title = {Multipath Component-Aided Signal Processing for Integrated Sensing and Communication Systems},
  author = {Haotian Liu and Zhiqing Wei* and Xiyang Wang and Yangyang Niu and Yixin Zhang and Huici Wu and Zhiyong Feng},
  booktitle = {2025 IEEE Wireless Communications and Networking Conference (WCNC)},
  year = {2025},
  citations = {4},
  month = may,
  url = {https://ieeexplore.ieee.org/document/10978578},
  doi = {10.1109/WCNC61545.2025.10978578},
  keywords = {Integrated Sensing and Communication, Multipath, Signal Processing},
  abstract = {Integrated sensing and communication (ISAC) has emerged as a pivotal enabling technology for sixth-generation (6G) mobile communication system. The ISAC research in dense urban areas has been plaguing by severe multipath interference, propelling the thorough research of ISAC multipath interference elimination. However, transforming the multipath component (MPC) from enemy into friend is a viable and mutually beneficial option. In this paper, we preliminarily explore the MPC-aided ISAC signal processing and apply a space-time code to improve the ISAC performance. Specifically, we propose a symbol-level fusion for MPC-aided localization (SFMC) scheme to achieve robust and high-accuracy localization, and apply a Khatri-Rao space-time (KRST) code to improve the communication and sensing performance in rich multipath environment. Simulation results demonstrate that the proposed SFMC scheme has more robust localization performance with higher accuracy, compared with the existing state-of-the-art schemes. The proposed SFMC would benefit highly reliable communication and sub-meter level localization in rich multipath scenarios.},
  preview = {liu2025component.jpg}
}

@inproceedings{zan2026ris,
  title = {Array Configuration and Signal Processing for RIS-Assisted Integrated Sensing and Communication Systems},
  author = {Jiaqi Zan and Zhiqing Wei and Haotian Liu and Shang Liu and Yuhan Long},
  booktitle = {2026 IEEE Wireless Communications and Networking Conference Workshops (WCNCW)},
  year = {2026},
  citations = {0},
  month = jun,
  url = {https://ieeexplore.ieee.org/document/11555411},
  doi = {10.1109/WCNCW67598.2026.11555411},
  keywords = {Integrated Sensing and Communication, RIS, Signal Processing},
  abstract = {In richly scattering environments such as intelligent transportation and intelligent manufacturing factory, the line-ofsight paths in integrated sensing and communication (ISAC) systems are frequently blocked, which significantly degrades sensing accuracy. Reconfigurable intelligent surface (RIS) has emerged as a promising technology to reshape the wireless propagation environment to improve ISAC performance. However, the full activation of RIS elements entails high power costs and heavy channel estimation burdens, which makes it difficult to preserve large aperture gains and high angular resolution. To address this challenge, we propose a coprime sparse RIS (CS-RIS) array configuration and develop a convolutional neural network (CNN)–based signal processing algorithm for the azimuth and elevation angles of multiple targets in richly scattering environments. Simulation results demonstrate that, compared with traditional equally spaced RIS array configuration, the proposed CS-RIS achieves significant gains in both unambiguous range and angular resolution. Moreover, the proposed CNN-based signal processing algorithm significantly outperforms the multiple signal classification (MUSIC) algorithm in target estimation accuracy.},
  preview = {zan2026ris.jpg}
}

@inproceedings{chen2026multiagent,
  title = {Multi-Agent Path Planning for Integrated Sensing, Communication, and Control Systems},
  author = {Guang Chen and Tao Zhang and Ying Zhou and Haotian Liu and Zhiqing Wei},
  booktitle = {2026 IEEE Wireless Communications and Networking Conference Workshops (WCNCW)},
  year = {2026},
  citations = {0},
  month = jun,
  url = {https://ieeexplore.ieee.org/document/11555438},
  doi = {10.1109/WCNCW67598.2026.11555438},
  keywords = {Integrated Sensing Communication and Control, Multi-Agent, Path Planning},
  abstract = {To address the challenges of limited sensing range, high computational overhead, and insufficient real-time performance in path planning for automated guided vehicles (AGV) systems in dynamic industrial scenarios, this paper proposes a perception-driven conflict-based search (P-CBS) algorithm. This method constructs a sensing cost mapping model within an integrated sensing, communication, and control (ISCC) framework, which integrates sensing, communication, and control functions into wireless networks to achieve reciprocal enhancement. This allows the system to adaptively balance sensing update frequency against communication load during path control. Specifically, it converts visual detection information such as position, speed, and confidence into a confidence-weighted spatiotemporal Gaussian cost field. Soft constraints are introduced in the A* search algorithm to achieve continuous obstacle avoidance. Furthermore, an event-triggered replanning mechanism based on cost growth rate prediction is designed, initiating global planning only when high risks accumulate, reducing computational load. Finally, a communication-adaptive threshold adjustment strategy is introduced to maintain system stability and consistency in bandwidth-constrained environments. Simulation results show that compared with traditional CBS and global dynamic CBS algorithms, the proposed algorithm can reduce the frequency of global replanning by at least 83% and improve system throughput by at least 12.5%, verifying its efficiency and robustness in dynamic industrial scenarios.},
  preview = {chen2026multiagent.jpg}
}

@inproceedings{chen2026adaptive,
  title = {Adaptive Resource Management for Multi-AGV Integrated Sensing, Communication, and Control Systems},
  author = {Guang Chen and Ying Zhou and Yunxin Geng and Haotian Liu and Zhiqing Wei*},
  booktitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence (CCAI)},
  year = {2026},
  citations = {0},
  pages = {558--563},
  doi = {10.1109/CCAI69603.2026.11641961},
  note = {Best Paper Award},
  keywords = {Resource Management, Multi-AGV, Two-Stage Adaptive Resource Management, Reinforcement Learning, Integrated Sensing Communication and Control},
  abstract = {To address the challenges of intense resource competition among communication, sensing, and control in industrial wireless networks, where communication congestion in large-scale intelligent clusters thus limits production throughput, this paper proposes a Two-stage Adaptive Resource Management (TARM) method for integrated sensing, communication, and control (ISCC) systems. In the first stage, focusing on automated guided vehicle (AGV) material transportation within automotive assembly workshops, a safety-guided multi-agent reinforcement learning (MARL) adaptive closed-loop interaction cycle method is proposed. The base station (BS) proactively harvests sensing data to dynamically reconstruct AGV kinematic states. By dynamically modulating the closed-loop interaction cycles of multiple AGVs, the system shifts from traditional fixed-period communication to an active on-demand paradigm, this transition significantly reduces the underlying communication load, thereby effectively elevating the upper bound of the controllable AGV cluster capacity. In the second stage, leveraging the expanded upper bound of the controllable cluster scale from the first stage, this paper derives a cooperative scheduling algorithm for multiple AGVs. By incorporating AGV kinematic characteristics and cluster expansion capabilities with production efficiency, the algorithm dynamically adjusts task allocation logic to achieve a precise matching between logistical supply efficiency and multi-line demands, thereby enhancing workshop throughput. Simulation results demonstrate that TARM substantially outperforms the traditional algorithm with nmax outage tolerance (TANOT), classic ISAC algorithm (CISACA), and traditional algorithm (TA) benchmarks, achieving a 56% reduction in global communication load and a throughput enhancement of at least 30.73%.},
  preview = {chen2026adaptive.jpg}
}

@inproceedings{xu2025delay,
  title = {Delay Performance Analysis with Short Packets in Intelligent Machine Networks},
  author = {Wenyan Xu and Zhiqing Wei* and Zhiqun Song and Yixin Zhang and Haotian Liu and Ying Zhou and Xiaoyu Yang and Yashan Pang},
  booktitle = {2025 IEEE 102nd Vehicular Technology Conference (VTC)},
  year = {2025},
  citations = {2},
  month = oct,
  url = {https://ieeexplore.ieee.org/document/11310533},
  doi = {10.1109/VTC2025-Fall65116.2025.11310533},
  keywords = {Short Packets, Intelligent Machine Network, Delay Analysis},
  abstract = {The increasing demand for delay-sensitive services in industrial manufacturing, the Internet of Vehicles, and smart logistics imposes stringent delay requirements on intelligent machine (IM) networks. To reduce latency, short packet transmissions are widely used. However, their impact on network delay performance remains underexplored, particularly in large-scale deployments prone to packet collisions and queuing congestion. This paper develops a theoretical framework for modeling downlink communication and derives analytical expressions for three key delay metrics: transmission success probability, expected delay, and delay jitter. By incorporating finite blocklength constraints, we accurately characterize the effects of IM density and packet length on delay performance. Simulation results validate our model, offering valuable insights for optimizing IM network design and improving real-time communication efficiency.},
  preview = {xu2025delay.jpg}
}

@inproceedings{wang2025factory,
  title = {ISAC 3D Imaging in Smart Factories Assisted by Multipath Components},
  author = {Han Wang and Yixin Zhang* and Zhiqing Wei and Haotian Liu and Hui Yu and Dingyou Ma and Qixun Zhang and Zhiyong Feng},
  booktitle = {2025 Seventeenth International Conference on Wireless Communications and Signal Processing (WCSP)},
  year = {2025},
  citations = {1},
  month = oct,
  url = {https://ieeexplore.ieee.org/document/11352278},
  doi = {10.1109/WCSP68525.2025.1010639},
  keywords = {Integrated Sensing and Communication, 3D Imaging, Multipath},
  abstract = {Integrated Sensing and Communication (ISAC) is profoundly reshaping the future of smart factories, where 3D imaging technology is an indispensable technology for constructing “digital twins”. However, in the complex indoor environment of factories, there is a severe multipath effect, which poses a significant bottleneck for mainstream research primarily aimed at eliminating such interference. Nevertheless, converting the adverse multipath components (MC) into usable components is a feasible and mutually beneficial option. This paper proposes an innovative framework that utilizes MC for target imaging to achieve robust positioning and perception. In this paper, we propose the 2D-FFT with 2D-MUSIC assisted by multipath components algorithm (FMMC) for positioning and imaging using uplink (UL) OFDM signals. First, the parameter estimations of all propagation paths are obtained using the 2D-FFT with 2D-MUSIC (FM) algorithm. Then, based on these estimates, we propose a two-Way virtual anchor mapping (TVAM) algorithm. This method effectively divides MC into line-of-sight (LoS) path, environmental reflections (AGV-Environment-BS) paths, and target reflections (AGV-Target-BS) paths. We use environmental reflection paths to assist LoS paths for AV positioning, improving positioning accuracy by more than 90% compared to using only the LoS path. Finally, we use the more accurate AGV location and estimates for imaging, significantly enhancing imaging performance by more than 14.6%.},
  preview = {wang2025factory.jpg}
}

@inproceedings{zheng2025urban,
  title = {ISAC 3D Imaging in Urban Environments: A Joint Active and Passive Sensing Approach},
  author = {Linbin Zheng and Yixin Zhang* and Zhiqing Wei and Dingyou Ma and Haotian Liu and Qixun Zhang and Zhiyong Feng},
  booktitle = {2025 Seventeenth International Conference on Wireless Communications and Signal Processing (WCSP)},
  year = {2025},
  citations = {0},
  month = oct,
  url = {https://ieeexplore.ieee.org/document/11352316},
  doi = {10.1109/WCSP68525.2025.1010635},
  keywords = {Integrated Sensing and Communication, 3D Imaging, Active and Passive Sensing},
  abstract = {Integrated sensing and communication (ISAC) technology is driving the evolution of communication systems towards more refined sensing capabilities. In this trend, imaging has emerged as a core sensing modality, drawing significant research attention for its ability to provide rich environmental details. To achieve efficient and accurate outdoor environment reconstruction, we propose a single base station (BS) and unmanned aerial vehicle (UAV) collaborative environment imaging scheme. The BS performs active sensing (AS), and using the sub-array coherent average-4D-FFT (SCA-4D-FFT) algorithm to achieve preliminary imaging of the environment, the UAV flies along a specific trajectory to form a synthetic aperture radar (SAR), assisting the BS in PS with high resolution, and using the frequency domain back-projection (FDBP) algorithm to generate high-resolution images. To fuse the advantages of the two sensing modes, the density-based spatial clustering of applications with noise (DBSCAN) algorithm is utilized to jointly process the original point cloud data obtained from AS and PS. Simulation results show that the collaborative fusion algorithm proposed in this paper significantly reduces the chamfer distance (CD) value and achieves a notable performance improvement compared to both of the two individual algorithms.},
  preview = {zheng2025urban.jpg}
}
