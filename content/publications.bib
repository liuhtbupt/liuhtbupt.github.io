}

@article{liu2026allpole,
  title = {Signal Processing Algorithm Based on All-Pole Model for ISAC Multi-Band Fusion Signals},
  author = {Haotian Liu and Zhiqing Wei* and Dongjie Li and Yu Cai and Zhiyong Feng},
  journal = {Journal of Beijing University of Posts and Telecommunications},
  year = {2026},
  citations = {0},
  month = apr,
  url = {https://journal.bupt.edu.cn/CN/Y2026/V49/I2/54},
  doi = {10.13190/j.jbupt.2025-115},
  keywords = {Integrated Sensing and Communication, Multi-Band, Signal Processing},
  abstract = {To meet the demand for reliable communication and high-precision sensing in emerging industries such as the low-altitude economy and intelligent transportation, while also improving the spectral efficiency and sensing performance of integrated sensing and communication (ISAC) technology in sixth-generation wireless networks, a white space data recovery algorithm is investigated to address the challenges of insufficient sensing robustness at low signal-to-noise ratio (SNR) in ISAC-based multi-band fusion signals and the degradation of sensing power spectrum sidelobes caused by white space. This study proposed a white space data recovery algorithm based on an all-pole model. This algorithm first constructs a unified all-pole model based on the principle of range and echo phase. Then, it solves the model's pole and amplitude parameters using improved matrix bundling and maximum likelihood estimation. Finally, an iterative optimization strategy is proposed to recover white space data and denoise non-white space bands. Simulation results demonstrate the feasibility and superiority of the proposed algorithm. Compared to traditional fast Fourier transform method and advanced compressed sensing method, the proposed algorithm can operate at a lower SNR while achieving the same range estimation accuracy, thereby effectively improving robustness.},
  preview = {liu2026allpole.jpg}
}

@article{li2025multirsu,
  title = {Uplink Multi-RSU Cooperative Sensing Strategy for Integrated Sensing and Communication System},
  author = {Yiheng Li and Zhiqing Wei* and Haotian Liu* and Zhiyong Feng*},
  journal = {IEEE Transactions on Cognitive Communications and Networking},
  year = {2025},
  citations = {6},
  cas_zone = {1},
  cas_top = {true},
  cas_year = {2025},
  jcr_quartile = {Q1},
  jcr_year = {2025},
  impact_factor = {7.0},
  impact_factor_year = {2025},
  month = may,
  url = {https://ieeexplore.ieee.org/document/11005389},
  doi = {10.1109/TCCN.2025.3570449},
  keywords = {Integrated Sensing and Communication, Cooperative Sensing, RSU},
  abstract = {Integrated Sensing and Communication (ISAC) is expected to be a key technology for next-generation wireless networks due to its efficient use of spectrum and device resources. In Internet of Vehicles (IoV) networks, however, mutual interference can substantially degrade sensing accuracy in multi-user, multi-target scenarios. Moreover, the limited sensing capability of a single roadside unit (RSU) further highlights the need for cooperative sensing among multiple RSUs. This paper investigates multi-RSU cooperative sensing within an uplink ISAC framework. Firstly, the stochastic geometry is employed to model the distribution of communication user equipments (COM- UEs), and a closed-form expression for interference power is derived. Aiming at mitigate the mutual interference effectively, we then investigate receive beamforming design to minimize the sensing beampattern matching error while meeting communication requirements. To address time offset (TO) and carrier frequency offset (CFO) due to asynchronous transceivers, we propose a cross-path cross-correlation (CPCC) scheme between line-ofsight (LOS) and non-LOS (NLOS) signals, effectively reducing ambiguity in range and velocity estimation. Furthermore, a symbol-level fusion method for multi-RSUs’ sensing information is proposed. The phase information matrices extracted from echo signals across multi-RSUs are conducted independent matching and weighted fusion to enhance cooperative sensing accuracy. Simulations show that our approach outperforms single-RSU sensing, with improvements of 52.3% and 64.1% in localization and velocity estimation, respectively. Compared to data-level fusion, the symbol-level approach yields further enhancements of 44.8% in localization and 64.6% in velocity estimation.},
  preview = {li2025multirsu.jpg}
}

@article{wei2024reference,
  title = {Multiple Reference Signals Collaborative Sensing for Integrated Sensing and Communication System Towards 5G-A and 6G},
  author = {Zhiqing Wei and Fengyun Li* and Haotian Liu and Xu Chen and Huici Wu and Kaifeng Han and Zhiyong Feng},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2024},
  citations = {65},
